{
  "packages": [
    "go@1.25.4",
    "nodejs@22",
    "python@3.10",
    "python310Packages.pip",
    "golangci-lint@2.7.1",
    "gopls@latest",
    "postgresql_16@latest",
    "mailpit@latest",
    "valkey@latest"
  ],
  "include": ["github:networkteam/devbox-plugins?dir=postgresql"],
  "shell": {
    "scripts": {
      "backend:setup": ["devbox run backend:migrate", "devbox run backend:fixtures"],
      "backend:lint": [
        "cd backend",
        "golangci-lint run --output.tab.path stdout --output.text.path='' --show-stats=false --path-prefix backend"
      ],
      "backend:migrate": [
        "cd backend",
        "go run ./cli/ctl migrate up --allow-missing",
        "go run ./cli/ctl test preparedb"
      ],
      "backend:fixtures": [
        "cd backend",
        "go run ./cli/ctl fixtures import"
      ],
      "backend:gqlgen": ["cd backend", "go generate ./api/graph/..."],
      "docs:setup": [
        "cd docs",
        ". $VENV_DIR/bin/activate",
        "pip install -r requirements.txt"
      ],
      "docs:build": [
        "cd docs",
        ". $VENV_DIR/bin/activate",
        "mkdocs build"
      ],
      "docs:dev": [
        "cd docs",
        ". $VENV_DIR/bin/activate",
        "mkdocs serve"
      ],
      "goland:setup": [
        "sed -i 's#\\(<component name=\"GOROOT\" url=\\)\"[^\"]*\"#\\1\"file://\\$PROJECT_DIR\\$/.devbox/nix/profile/default/share/go\"#' .idea/workspace.xml",
        "grep -q 'GOROOT' .idea/workspace.xml || sed -i 's#</project>#<component name=\"GOROOT\" url=\"file://\\$PROJECT_DIR\\$/.devbox/nix/profile/default/share/go\" /></project>#' .idea/workspace.xml"
      ]
    }
  },
  "env": {
    "BACKEND_ENV": "development",
    "DATABASE_NAME": "myproject-dev",
    "TEST_DATABASE_NAME": "myproject-test",
    "DEVBOX_COREPACK_ENABLED": "true"
  }
}
